<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PokedexGen1.Models"
             x:Class="PokedexGen1.DetailPage"
             BackgroundColor="#F2F2F7">

    <ScrollView>
        <VerticalStackLayout>

            <!-- ═══════════════════════════════════════════════ -->
            <!--         Pokédex-Style Hero Header              -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid x:Name="Hero" HeightRequest="340" Padding="0">

                <!-- Top bar overlay (darkened panel) -->
                <BoxView HeightRequest="54"
                         BackgroundColor="#33000000"
                         VerticalOptions="Start" HorizontalOptions="Fill"/>

                <!-- Iconic black horizontal divider stripe -->
                <BoxView HeightRequest="6"
                         BackgroundColor="#EE000000"
                         VerticalOptions="Start" Margin="0,51,0,0"
                         HorizontalOptions="Fill"/>

                <!-- ① Large Pokédex "eye" — blue lens, top-left -->
                <Border WidthRequest="50" HeightRequest="50"
                        Margin="12,2,0,0"
                        HorizontalOptions="Start" VerticalOptions="Start"
                        BackgroundColor="#2255EE"
                        Stroke="White" StrokeThickness="3">
                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    <Grid>
                        <!-- Lens reflection highlight -->
                        <Ellipse Fill="White" Opacity="0.35"
                                 WidthRequest="14" HeightRequest="14"
                                 HorizontalOptions="Start" VerticalOptions="Start"
                                 Margin="5,4,0,0"/>
                    </Grid>
                </Border>

                <!-- ② Status indicator lights (red · yellow · green) -->
                <HorizontalStackLayout Margin="72,16,0,0"
                                       HorizontalOptions="Start" VerticalOptions="Start"
                                       Spacing="8">
                    <Border WidthRequest="15" HeightRequest="15"
                            BackgroundColor="#FF3333" Stroke="#CC1111" StrokeThickness="1">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    </Border>
                    <Border WidthRequest="15" HeightRequest="15"
                            BackgroundColor="#FFD700" Stroke="#CCAA00" StrokeThickness="1">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    </Border>
                    <Border WidthRequest="12" HeightRequest="12"
                            BackgroundColor="#33EE33" Stroke="#22BB22" StrokeThickness="1"
                            VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    </Border>
                </HorizontalStackLayout>

                <!-- ③ Pokédex entry number (top-right) -->
                <Label x:Name="NumberLabel"
                       TextColor="White" FontSize="20" FontAttributes="Bold"
                       Opacity="0.92" CharacterSpacing="1"
                       HorizontalOptions="End" VerticalOptions="Start"
                       Margin="0,14,16,0"/>

                <!-- ④ Pokémon Artwork — large, centred -->
                <Image x:Name="Artwork"
                       HeightRequest="230"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       Margin="0,46,0,44"/>

                <!-- Bottom black divider stripe -->
                <BoxView HeightRequest="6"
                         BackgroundColor="#EE000000"
                         VerticalOptions="End" Margin="0,0,0,38"
                         HorizontalOptions="Fill"/>

                <!-- Bottom bar overlay -->
                <BoxView HeightRequest="38"
                         BackgroundColor="#33000000"
                         VerticalOptions="End" HorizontalOptions="Fill"/>

                <!-- Bottom-left: decorative grip lines -->
                <VerticalStackLayout HorizontalOptions="Start" VerticalOptions="End"
                                     Margin="14,0,0,11" Spacing="5">
                    <BoxView HeightRequest="4" WidthRequest="60"
                             BackgroundColor="#66FFFFFF" CornerRadius="2"
                             HorizontalOptions="Start"/>
                    <BoxView HeightRequest="4" WidthRequest="38"
                             BackgroundColor="#66FFFFFF" CornerRadius="2"
                             HorizontalOptions="Start"/>
                </VerticalStackLayout>

                <!-- Bottom-right: decorative button circles -->
                <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="End"
                                       Margin="0,0,14,8" Spacing="10">
                    <Border WidthRequest="24" HeightRequest="24"
                            BackgroundColor="#00000000"
                            Stroke="#77FFFFFF" StrokeThickness="2.5">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    </Border>
                    <Border WidthRequest="24" HeightRequest="24"
                            BackgroundColor="#00000000"
                            Stroke="#77FFFFFF" StrokeThickness="2.5">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    </Border>
                </HorizontalStackLayout>

            </Grid>

            <VerticalStackLayout Padding="20" Spacing="14">
                <Label x:Name="NameLabel" FontSize="32" FontAttributes="Bold" TextColor="#222233" />

                <HorizontalStackLayout x:Name="TypeRow" Spacing="8" />

                <ActivityIndicator x:Name="Loader" IsRunning="True" Color="#CC0000" />
                <Label x:Name="DescriptionLabel" FontSize="15" TextColor="#44445A" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="White" Padding="14" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="HEIGHT" FontSize="11" TextColor="#9A9AB0" />
                            <Label x:Name="HeightLabel" Text="—" FontSize="18" FontAttributes="Bold" TextColor="#222233" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White" Padding="14" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="WEIGHT" FontSize="11" TextColor="#9A9AB0" />
                            <Label x:Name="WeightLabel" Text="—" FontSize="18" FontAttributes="Bold" TextColor="#222233" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="White" Padding="16" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Base Stats" FontSize="16" FontAttributes="Bold" TextColor="#222233" />
                        <VerticalStackLayout x:Name="StatsLayout" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:StatItem">
                                    <Grid ColumnDefinitions="70,40,*" ColumnSpacing="8">
                                        <Label Text="{Binding Name}" FontSize="13" TextColor="#6B6B80" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                               FontAttributes="Bold" TextColor="#222233" VerticalOptions="Center" />
                                        <ProgressBar Grid.Column="2" Progress="{Binding Progress}"
                                                     ProgressColor="#CC0000" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Back to Pokédex" BackgroundColor="#CC0000" TextColor="White"
                        FontAttributes="Bold" CornerRadius="22" Clicked="OnBackClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
