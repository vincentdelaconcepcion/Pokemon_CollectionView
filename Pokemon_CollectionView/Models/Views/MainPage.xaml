<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Pokemon_CollectionView.Models.Models"
             x:Class="PokedexGen1.MainPage"
             Title="Kanto Pokédex"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ════════════════════════════════════════════════════ -->
        <!--           Pokédex Entry-Style Header              -->
        <!-- ════════════════════════════════════════════════════ -->
        <Grid HeightRequest="140" BackgroundColor="#CC0000">

            <!-- Top-left darker panel -->
            <BoxView WidthRequest="148" BackgroundColor="#B30000"
                     HorizontalOptions="Start" VerticalOptions="Fill"/>

            <!-- Vertical divider between left panel and right -->
            <BoxView WidthRequest="5" BackgroundColor="#111111"
                     HorizontalOptions="Start" Margin="145,0,0,0"
                     VerticalOptions="Fill"/>

            <!-- ① Big Pokédex "eye" lens — top-left -->
            <Border WidthRequest="64" HeightRequest="64"
                    Margin="12,10,0,0"
                    HorizontalOptions="Start" VerticalOptions="Start"
                    BackgroundColor="#2255EE"
                    Stroke="White" StrokeThickness="4">
                <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                <Grid>
                    <!-- Gloss reflection -->
                    <Ellipse Fill="White" Opacity="0.35"
                             WidthRequest="18" HeightRequest="18"
                             HorizontalOptions="Start" VerticalOptions="Start"
                             Margin="6,5,0,0"/>
                </Grid>
            </Border>

            <!-- ② Small status indicator lights (beneath the eye) -->
            <HorizontalStackLayout Margin="16,0,0,12"
                                   HorizontalOptions="Start" VerticalOptions="End"
                                   Spacing="8">
                <Border WidthRequest="16" HeightRequest="16"
                        BackgroundColor="#FF3333" Stroke="#CC1111" StrokeThickness="1">
                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                </Border>
                <Border WidthRequest="16" HeightRequest="16"
                        BackgroundColor="#FFD700" Stroke="#CCAA00" StrokeThickness="1">
                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                </Border>
                <Border WidthRequest="13" HeightRequest="13"
                        BackgroundColor="#33EE33" Stroke="#22BB22" StrokeThickness="1"
                        VerticalOptions="Center">
                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                </Border>
            </HorizontalStackLayout>

            <!-- ③ Pokédex screen / title panel (right side) -->
            <Border Margin="158,12,12,12"
                    BackgroundColor="#1A1A2E"
                    Stroke="#444466" StrokeThickness="2"
                    HorizontalOptions="Fill" VerticalOptions="Fill">
                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                <Grid Padding="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Screen label (like a CRT header) -->
                    <Label Grid.Row="0"
                           Text="— POKÉDEX UNIT —"
                           TextColor="#55FF55" FontSize="9"
                           FontAttributes="Bold" CharacterSpacing="2"
                           HorizontalOptions="Center"/>

                    <!-- Main title -->
                    <Label Grid.Row="1"
                           Text="Kanto Pokédex"
                           TextColor="#EEEEFF" FontSize="24"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>

                    <!-- Region tag line -->
                    <Label Grid.Row="2"
                           Text="REGION: KANTO  ·  GEN I"
                           TextColor="#8888AA" FontSize="9"
                           CharacterSpacing="1"
                           HorizontalOptions="Center"/>
                </Grid>
            </Border>

            <!-- Horizontal black stripe at the bottom (Pokédex divider) -->
            <BoxView HeightRequest="5" BackgroundColor="#111111"
                     VerticalOptions="End" HorizontalOptions="Fill"/>

        </Grid>

        <!-- ── Search Bar (Row 1) ─────────────────────────── -->
        <Border Grid.Row="1" Margin="12,10,12,4"
                BackgroundColor="White"
                Stroke="#DDDDE8" StrokeThickness="1.5">
            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
            <SearchBar x:Name="Search"
                       Placeholder="Search by name, type or number…"
                       TextChanged="OnSearchChanged"
                       BackgroundColor="Transparent"/>
        </Border>

        <!-- ════════════════════════════════════════════════════ -->
        <!--        Pokédex Type Matrix Navigation Panel          -->
        <!-- ════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="10,4,10,4"
                BackgroundColor="White"
                Stroke="#DDE1EA"
                StrokeThickness="1.5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="6" Padding="10,7,10,7">

                <!-- ── Navigation Panel Status & Summary Bar ────── -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

                    <!-- Left: Pokédex Terminal Scanner Status -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="7" VerticalOptions="Center">
                        <!-- Glowing LED Status Dot -->
                        <Border WidthRequest="8" HeightRequest="8"
                                BackgroundColor="#10B981"
                                Stroke="#059669" StrokeThickness="1"
                                VerticalOptions="Center">
                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        </Border>

                        <Label Text="TYPE MATRIX"
                               FontSize="10" FontAttributes="Bold"
                               TextColor="#1E293B" CharacterSpacing="1"
                               VerticalOptions="Center"/>

                        <Label Text="· ELEMENT CLASSIFICATION"
                               FontSize="9" FontAttributes="Bold"
                               TextColor="#94A3B8" CharacterSpacing="0.8"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Right: Active Selection Badge / 1-Tap Reset Button -->
                    <Border Grid.Column="1"
                            x:Name="ActiveFilterBadge"
                            BackgroundColor="#F1F5F9"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            Padding="8,3"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResetTypeClicked"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label x:Name="ActiveFilterIcon" Text="🔘" FontSize="11" VerticalOptions="Center"/>
                            <Label x:Name="ActiveFilterLabel" Text="ALL (151)"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="#334155" CharacterSpacing="0.5"
                                   VerticalOptions="Center"/>
                            <Label x:Name="ActiveFilterResetPrompt" Text="✕"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="#EF4444" IsVisible="False"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- ── Scrollable Designated Type Capsules ────── -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="TypeFilterStack"
                                           BindableLayout.ItemsSource="{Binding TypeFilters}"
                                           Spacing="9"
                                           Padding="2,2,4,4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TypeFilterModel">
                                <Border Background="{Binding CardBackground}"
                                        Stroke="{Binding CardBorderColor}"
                                        StrokeThickness="{Binding CardBorderThickness}"
                                        Padding="10,5,12,5"
                                        HeightRequest="56"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTypeFilterTapped" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                                        <!-- Designated Type Icon Pod -->
                                        <Border WidthRequest="36" HeightRequest="36"
                                                Background="{Binding IconContainerBackground}"
                                                Stroke="{Binding IconBorderColor}"
                                                StrokeThickness="1.5"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <Ellipse/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Icon}"
                                                   FontSize="18"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Designated Type Typography & Subtitle -->
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   TextColor="{Binding NameColor}"
                                                   CharacterSpacing="0.4"/>
                                            <Label Text="{Binding Subtitle}"
                                                   FontSize="8.5"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding SubtitleColor}"
                                                   CharacterSpacing="0.4"/>
                                        </VerticalStackLayout>

                                        <!-- Designated Type Count Badge -->
                                        <Border BackgroundColor="{Binding BadgeBackground}"
                                                Padding="7,2"
                                                Margin="4,0,0,0"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Count}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding BadgeTextColor}"/>
                                        </Border>

                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

            </VerticalStackLayout>
        </Border>

        <!-- ════════════════════════════════════════════════════ -->
        <!--    Pokédex Main Screen Unit (Bezel + Screen HUD)   -->
        <!-- ════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Margin="10,6,10,10"
                BackgroundColor="#D6DAE2"
                Stroke="#9CA3AF" StrokeThickness="2.5"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18"/>
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- ── 1. Top Bezel Bar: Scanner Sensors ──────── -->
                <Grid Grid.Row="0" HeightRequest="28" Padding="14,0" BackgroundColor="#CCD1DC">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Text="SILPH CO. / DEX-01"
                           FontSize="9" FontAttributes="Bold"
                           TextColor="#6B7280" CharacterSpacing="1"
                           VerticalOptions="Center"/>

                    <!-- Dual Red Sensor Lights -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Border WidthRequest="10" HeightRequest="10"
                                BackgroundColor="#EF4444" Stroke="#991B1B" StrokeThickness="1">
                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                            <Ellipse Fill="White" Opacity="0.5" WidthRequest="3" HeightRequest="3"
                                     HorizontalOptions="Start" VerticalOptions="Start" Margin="2,1,0,0"/>
                        </Border>
                        <Border WidthRequest="10" HeightRequest="10"
                                BackgroundColor="#EF4444" Stroke="#991B1B" StrokeThickness="1">
                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                            <Ellipse Fill="White" Opacity="0.5" WidthRequest="3" HeightRequest="3"
                                     HorizontalOptions="Start" VerticalOptions="Start" Margin="2,1,0,0"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Label Grid.Column="2" Text="SYSTEM: ONLINE"
                           FontSize="9" FontAttributes="Bold"
                           TextColor="#16A34A" CharacterSpacing="1"
                           HorizontalOptions="End" VerticalOptions="Center"/>
                </Grid>

                <!-- ── 2. The High-Tech Digital Screen ────────── -->
                <Border Grid.Row="1"
                        Margin="8,0,8,0"
                        BackgroundColor="#0E1624"
                        Stroke="#1F2937" StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto,*">

                        <!-- Digital HUD Header Bar -->
                        <Grid Grid.Row="0" HeightRequest="32" BackgroundColor="#152033" Padding="12,0">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Border WidthRequest="7" HeightRequest="7" BackgroundColor="#22C55E">
                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                </Border>
                                <Label Text="DATA ARCHIVE" TextColor="#22C55E"
                                       FontSize="10" FontAttributes="Bold"
                                       CharacterSpacing="1" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Live Entry Counter Label (referenced in C#) -->
                            <Label x:Name="CountLabel"
                                   Text="151 Pokémon"
                                   TextColor="#38BDF8"
                                   FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   HorizontalOptions="End" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Screen Viewport: Background Graphics + CollectionView -->
                        <Grid Grid.Row="1">

                            <!-- High-Tech Background HUD Details (non-interactive) -->
                            <Grid InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill">

                                <!-- Subtle CRT scanline grids -->
                                <VerticalStackLayout Spacing="36" Opacity="0.04" Margin="0,12,0,0">
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                    <BoxView HeightRequest="1" Color="White" HorizontalOptions="Fill"/>
                                </VerticalStackLayout>

                                <!-- Holographic Pokédex / Pokéball Emblem -->
                                <Grid HorizontalOptions="Center" VerticalOptions="Center"
                                      WidthRequest="220" HeightRequest="220"
                                      Opacity="0.07">
                                    <Ellipse Stroke="#38BDF8" StrokeThickness="6"
                                             WidthRequest="220" HeightRequest="220"/>
                                    <BoxView HeightRequest="6" Color="#38BDF8"
                                             VerticalOptions="Center" HorizontalOptions="Fill"/>
                                    <Border WidthRequest="66" HeightRequest="66"
                                            BackgroundColor="#0E1624"
                                            Stroke="#38BDF8" StrokeThickness="5"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                        <Ellipse Fill="#38BDF8" WidthRequest="28" HeightRequest="28"
                                                 HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Corner Tech Reticles (Top-Left & Bottom-Right) -->
                                <Label Text="⬡ KANTO_GRID_v1" TextColor="#1E3A5F" FontSize="9"
                                       FontAttributes="Bold" Margin="10,6,0,0"
                                       HorizontalOptions="Start" VerticalOptions="Start"/>
                                <Label Text="SYS_ID: 001-151" TextColor="#1E3A5F" FontSize="9"
                                       FontAttributes="Bold" Margin="0,0,10,6"
                                       HorizontalOptions="End" VerticalOptions="End"/>
                            </Grid>

                            <!-- The Pokémon CollectionView -->
                            <CollectionView x:Name="PokemonView"
                                            Margin="10,10,10,10"
                                            SelectionMode="Single"
                                            SelectionChanged="OnPokemonSelected">

                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="2"
                                                     VerticalItemSpacing="10" HorizontalItemSpacing="10" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,60">
                                        <Border WidthRequest="44" HeightRequest="44"
                                                BackgroundColor="#33EF4444" Stroke="#EF4444" StrokeThickness="2"
                                                HorizontalOptions="Center">
                                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                            <Label Text="!" TextColor="#EF4444" FontSize="24" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="NO MATCHING RECORD" TextColor="#EF4444"
                                               FontAttributes="Bold" FontSize="14" CharacterSpacing="1"
                                               HorizontalOptions="Center" />
                                        <Label Text="No Pokémon found matching this query." TextColor="#64748B"
                                               FontSize="12" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Pokemon">
                                        <Border BackgroundColor="White" Stroke="{Binding Type1Color}"
                                                StrokeThickness="2" Padding="10">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding NumberText}" FontSize="12" TextColor="#9A9AB0"
                                                       HorizontalOptions="End" />
                                                <Image Source="{Binding ImageUrl}" HeightRequest="110" Aspect="AspectFit" />
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                                       TextColor="#222233" HorizontalOptions="Center"
                                                       LineBreakMode="TailTruncation" />
                                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                                    <Border BackgroundColor="{Binding Type1Color}" Padding="8,2" StrokeThickness="0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                        <Label Text="{Binding Type1}" FontSize="11" TextColor="White" FontAttributes="Bold" />
                                                    </Border>
                                                    <Border BackgroundColor="{Binding Type2Color}" Padding="8,2" StrokeThickness="0"
                                                            IsVisible="{Binding HasType2}">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                                        <Label Text="{Binding Type2}" FontSize="11" TextColor="White" FontAttributes="Bold" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </Grid>
                    </Grid>
                </Border>

                <!-- ── 3. Bottom Bezel Bar: Speaker Vents & Buttons -->
                <Grid Grid.Row="2" HeightRequest="30" Padding="14,0" BackgroundColor="#CCD1DC">
                    <!-- Red Push-button (Left) -->
                    <Border WidthRequest="16" HeightRequest="16"
                            BackgroundColor="#DC2626" Stroke="#991B1B" StrokeThickness="1.5"
                            HorizontalOptions="Start" VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Ellipse Fill="White" Opacity="0.4" WidthRequest="4" HeightRequest="4"
                                 HorizontalOptions="Start" VerticalOptions="Start" Margin="3,2,0,0"/>
                    </Border>

                    <!-- Speaker Ventilation Slits (Right) -->
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                        <BoxView WidthRequest="24" HeightRequest="3.5" Color="#64748B" CornerRadius="1.5"/>
                        <BoxView WidthRequest="24" HeightRequest="3.5" Color="#64748B" CornerRadius="1.5"/>
                        <BoxView WidthRequest="24" HeightRequest="3.5" Color="#64748B" CornerRadius="1.5"/>
                    </HorizontalStackLayout>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</ContentPage>
